# Go build artifacts
/reins
/bin/
*.test
*.out

# per-machine Makefile overrides (instance, not engine)
reins.local.mk

# Python
__pycache__/
*.pyc
/api/.venv/
/api/uv.lock

# instance config (never commit real paths/secrets)
/config.toml

# property-based testing artifact cache (regenerable)
/.hypothesis/

# coverage databases are build output, never source
.coverage
api/.coverage

# estate identity tokens for the estate-independence scan (instance, never exportable).
# The guard is law and ships; what it matches is estate data and does not. See api/conftest.py.
/.estate-tokens
