#!/usr/bin/env bash
# hapax-secret — operator ritual. PUT is TTY dialogue via reins loopback.
# GET remains name-on-argv for watchdogs. No baked operator-absolute paths.
#
# Enrollment: a host without FileStore .key forwards to the configured
# HAPAX_SECRETS_HOST (or ~/.config/reins/secrets-host). ssh -t only for put (no args).
set -euo pipefail

STORE_ROOT="${REINS_SECRET_STORE:-${HOME}/.config/reins/secrets}"
HOST_FILE="${REINS_SECRETS_HOST_FILE:-${HOME}/.config/reins/secrets-host}"
HOST="${HAPAX_SECRETS_HOST:-}"
if [[ -z "$HOST" && -r "$HOST_FILE" ]]; then
  HOST="$(tr -d '[:space:]' < "$HOST_FILE")"
fi
REMOTE='$HOME/.local/bin/hapax-secret'

if [[ "$HOST" == -* ]]; then
  echo "hapax-secret: HAPAX_SECRETS_HOST must not start with '-'. Next action: set a valid FileStore hostname." >&2
  exit 2
fi

if [[ "${HAPAX_SECRETS_FORCE_REMOTE:-}" == "1" || ! -f "${STORE_ROOT}/.key" ]]; then
  if [[ -z "$HOST" ]]; then
    echo "hapax-secret: HAPAX_SECRETS_HOST is not configured. Next action: set HAPAX_SECRETS_HOST or write ~/.config/reins/secrets-host." >&2
    exit 2
  fi
  if ! command -v ssh >/dev/null 2>&1; then
    echo "hapax-secret: ssh not found on PATH. Next action: install OpenSSH or run on the FileStore host." >&2
    exit 2
  fi
  if [[ $# -eq 0 || "${1:-}" == "--delete" ]]; then
    quoted="$REMOTE"
    for arg in "$@"; do
      quoted+=" $(printf '%q' "$arg")"
    done
    exec ssh -o BatchMode=yes -o ConnectTimeout=8 -t -- "$HOST" "$quoted"
  fi
  quoted="$REMOTE"
  for arg in "$@"; do
    quoted+=" $(printf '%q' "$arg")"
  done
  exec ssh -o BatchMode=yes -o ConnectTimeout=8 -- "$HOST" "$quoted"
fi

API="${HAPAX_REINS_API:-${HOME}/.local/share/reins/current/api}"
if [[ ! -f "${API}/hapax_secret.py" ]]; then
  API="${HOME}/projects/reins/api"
fi
export PYTHONPATH="${API}${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m hapax_secret "$@"
