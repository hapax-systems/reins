#!/usr/bin/env bash
# hapax-secret — operator ritual. PUT is TTY dialogue via reins loopback.
# GET remains name-on-argv for watchdogs. No baked operator-absolute paths.
#
# Enrollment: a host without FileStore .key forwards to HAPAX_SECRETS_HOST
# (default hapax-appendix). ssh -t only for put (no args).
set -euo pipefail

STORE_ROOT="${REINS_SECRET_STORE:-${HOME}/.config/reins/secrets}"
HOST="${HAPAX_SECRETS_HOST:-hapax-appendix}"
REMOTE='$HOME/.local/bin/hapax-secret'

if [[ "${HAPAX_SECRETS_FORCE_REMOTE:-}" == "1" || ! -f "${STORE_ROOT}/.key" ]]; then
  if [[ $# -eq 0 ]]; then
    exec ssh -o BatchMode=yes -o ConnectTimeout=8 -t "$HOST" "$REMOTE"
  fi
  exec ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" "$REMOTE" "$@"
fi

API="${HAPAX_REINS_API:-${HOME}/projects/reins/api}"
export PYTHONPATH="${API}${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m hapax_secret "$@"
